    },
    "Time to fast. Start whenever you’re ready." : {
      "comment" : "Eating-window-closed notification body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يمكن بدء الصيام في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeit zu fasten. Starte, wann du bereit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hora de ayunar. Empieza cuando estés listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est l’heure de jeûner. Commencez quand vous voulez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "断食の時間です。準備ができたら始めましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "단식할 시간이에요. 준비되면 시작하세요."
