    "Ketones are climbing. You’re well into fat-burning now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى الكيتونات يرتفع. أنت الآن في ذروة حرق الدهون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ketonwerte steigen. Du verbrennst jetzt kräftig Fett."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cetonas están subiendo. Ya estás quemando grasa de lleno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cétones augmentent. Vous brûlez pleinement les graisses maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ケトン体が増えています。脂肪燃焼が本格的に進んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케톤 수치가 오르고 있어요. 지금 본격적으로 지방을 태우고 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
