    },
    "This overlaps a fast you already saved (%@). Pick another time, or open that fast and delete it." : {
      "comment" : "Refusal reason (S4). %@ = the saved fast's span. Budgeted at 4 German lines. ar: do not use bare السجل for a single record - it also names the History screen.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتداخل هذا الوقت مع صيام محفوظ (%@). اختر وقتًا آخر، أو احذفه من سجلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschneidet sich mit einem gespeicherten Fasten (%@). Wähle einen anderen Zeitpunkt oder lösche dieses Fasten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solapa con un ayuno que ya guardaste (%@). Elige otra hora, o abre ese ayuno y bórralo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chevauche un jeûne déjà enregistré (%@). Choisissez un autre horaire, ou ouvrez ce jeûne pour le supprimer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの断食（%@）と重なっています。別の時刻を選択するか、その断食を開いて削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 저장된 단식과 겹쳐요 (%@). 다른 시각을 선택하거나 그 단식을 열어 삭제하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nachodzi na zapisany post (%@). Wybierz inną godzinę albo otwórz ten post i usuń go."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетинається зі збереженим постом (%@). Оберіть інший час або відкрийте той піст і видаліть його."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该时间与已保存的断食（%@）重叠。请选择其他时间，或打开那次断食并删除。"
          }
        }
      }
    },
