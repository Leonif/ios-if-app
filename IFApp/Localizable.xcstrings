    "Something interrupted it before the payment went through. Nothing will be charged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف الأمر قبل إتمام الدفع، ولن يتم تحصيل أي مبلغ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas hat den Vorgang unterbrochen, bevor die Zahlung durchging. Dir wird nichts berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La operación se interrumpió antes de completar el pago. No se te cobrará nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelque chose a interrompu l’opération avant la fin du paiement. Rien ne vous sera facturé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払いの途中で処理が中断されました。請求は発生しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구입 도중에 문제가 생겨서 완료하지 못했어요. 금액은 청구되지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś przerwało proces przed zakończeniem płatności. Nie naliczymy żadnej opłaty."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щось перервало процес до завершення оплати. Плату не буде стягнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "付款完成前，操作被中断了。不会向你收取任何费用。"
          }
        }
      }
    },
