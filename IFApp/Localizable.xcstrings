    "Fast complete. Your eating window is open. Refuel gently.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل الصيام. نافذة الأكل مفتوحة. عاود الأكل بهدوء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten abgeschlossen. Dein Essensfenster ist offen. Iss behutsam wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno completado. Tu ventana de comida está abierta. Reincorpora alimentos con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne terminé. Votre fenêtre alimentaire est ouverte. Rechargez en douceur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食完了。食事の時間帯が始まりました。ゆっくり食事を再開しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "단식 완료. 식사 시간이 시작됐어요. 부드럽게 다시 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post ukończony. Twoje okno żywieniowe jest otwarte. Wracaj do jedzenia łagodnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Піст завершено. Вікно харчування відкрите. Відновлюйтеся поступово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食完成。你的进食窗口已开启。请温和地恢复进食。"
          }
        }
      }
    },
    "Fast complete. Your eating window is ready. Refuel gently.": {
      "comment": "Editorial on the complete screen — the window has NOT opened yet, it opens when the user taps 'Start eating window'. The open-window variant is the '…is open…' string.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اكتمل الصيام. نافذة الأكل جاهزة. عاود الأكل بهدوء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten abgeschlossen. Dein Essensfenster ist bereit. Iss behutsam wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuno completado. Tu ventana de comida está lista. Reincorpora alimentos con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeûne terminé. Votre fenêtre alimentaire est prête. Rechargez en douceur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "断食完了。食事の時間帯の準備ができました。ゆっくり再開しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 완료. 식사 시간을 시작할 수 있어요. 부드럽게 다시 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post ukończony. Twoje okno żywieniowe jest gotowe. Wracaj do jedzenia łagodnie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Піст завершено. Вікно харчування готове. Відновлюйтеся поступово."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断食完成。你的进食窗口已准备就绪。请温和地恢复进食。"
          }
        }
      }
    },
