    "%@ begins in %@": {
      "comment": "Next phase chip, e.g. 'Autophagy begins in 2h 36m'",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ %1$@ خلال %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beginnt in %2$@"
          }
        },
