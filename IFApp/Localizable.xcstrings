    "Deep in the fast. Autophagy is recycling what your cells no longer need.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت في عمق الصيام. الالتهام الذاتي يعيد تدوير ما لم تعد خلاياك بحاجة إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tief im Fasten. Die Autophagie recycelt, was deine Zellen nicht mehr brauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pleno ayuno. La autofagia recicla lo que tus células ya no necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En plein jeûne. L'autophagie recycle ce dont vos cellules n'ont plus besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食の深いフェーズ。オートファジーが、細胞に不要になったものをリサイクルしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식의 깊은 단계입니다. 오토파지가 세포에 더 이상 필요 없는 것을 재활용하고 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głęboko w poście. Autofagia przetwarza to, czego komórki już nie potrzebują."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Глибока фаза фастингу. Автофагія переробляє те, що клітинам більше не потрібне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已进入断食深层阶段。自噬正在回收细胞不再需要的物质。"
          }
        }
      }
    },
