    "Any whole hour, not only the four presets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي ساعة كاملة، لا الخطط الأربع الجاهزة فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede volle Stunde, nicht nur die vier Vorgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier hora entera, no solo las cuatro predefinidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’importe quelle heure entière, pas seulement les quatre proposées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決まった4つのプランだけでなく、1時間単位で選べます。"
