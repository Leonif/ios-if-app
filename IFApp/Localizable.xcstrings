    "First one saved. Finish tomorrow's fast and your streak begins." : {
      "comment" : "Note on the summary card after the first fast",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تم حفظ أول صيام لك. بإتمام صيام الغد تبدأ سلسلتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das erste ist gespeichert. Beende morgen dein Fasten und deine Serie beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El primero está guardado. Termina el ayuno de mañana y tu racha comienza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le premier est enregistré. Terminez le jeûne de demain et votre série commence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最初の1回を保存しました。明日の断食を終えると連続記録が始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 기록을 저장했어요. 내일 단식을 마치면 연속 기록이 시작돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pierwszy zapisany. Ukończ jutrzejszy post, a zacznie się seria."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перше збережено. Завершіть завтрашній піст - і почнеться серія."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "第一次已保存。完成明天的断食，连续记录就开始了。"
          }
        }
      }
    },
    "Glucose is easing down. Your body is leaning on its glycogen stores for fuel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستوى الجلوكوز ينخفض. يعتمد جسمك على مخزون الجليكوجين للحصول على الطاقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Glukosespiegel sinkt. Dein Körper greift auf seine Glykogenspeicher zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La glucosa está bajando. Tu cuerpo recurre a sus reservas de glucógeno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La glycémie diminue. Votre corps puise dans ses réserves de glycogène."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血糖値が下がっています。体はグリコーゲンの蓄えをエネルギーにし始めています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혈당이 낮아지고 있어요. 몸이 글리코겐 저장분을 연료로 사용하기 시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poziom glukozy spada. Ciało sięga po zapasy glikogenu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рівень глюкози знижується. Тіло переходить на запаси глікогену."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血糖正在下降。身体开始动用糖原储备来供能。"
          }
        }
      }
    },
