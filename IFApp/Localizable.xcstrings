    "One missed day a month leaves your streak intact.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ausgelassener Tag beendet deine Serie nicht. Einmal pro Kalendermonat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوم واحد يفوتك في الشهر الميلادي لا يقطع سلسلتك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día perdido al mes natural no rompe tu racha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour manqué par mois civil ne casse pas votre série."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月に一度なら、休んでも連続記録は途切れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달에 하루는 놓쳐도 연속 기록이 끊기지 않아요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden pominięty dzień w miesiącu kalendarzowym nie przerywa serii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один пропущений день на календарний місяць не обриває серію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个自然月漏掉一天，连续天数不会中断。"
          }
        }
      }
    },
