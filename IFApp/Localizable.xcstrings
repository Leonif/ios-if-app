    "A missed day stays a missed day - your streak keeps counting from where it was." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم الذي فاتك يبقى كما هو، وسلسلتك تستمر من حيث كانت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ausgelassener Tag bleibt ein ausgelassener Tag - deine Serie zählt weiter, wo sie stand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día perdido sigue siendo un día perdido: tu racha sigue contando desde donde estaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour manqué reste un jour manqué : votre série continue de compter là où elle en était."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休んだ日はそのまま残り、連続記録はそこから続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "놓친 하루는 놓친 하루로 남아요. 연속 기록만 그대로 이어져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pominięty dzień pozostaje pominięty - seria liczy się dalej od miejsca, w którym była."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропущений день лишається пропущеним - серія рахується далі з того місця, де була."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漏掉的一天还是漏掉的一天，连续天数从原来的地方接着数。"
          }
        }
      }
    },
