    "Ketones are climbing. You're well into fat-burning now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى الكيتونات يرتفع. أنت الآن في ذروة حرق الدهون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ketonwerte steigen. Du verbrennst jetzt kräftig Fett."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cetonas están subiendo. Ya estás quemando grasa de lleno."
          }
        },
        "fr": {
          "stringUnit": {
