          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, wann du bereit bist, oder trage deine letzte Mahlzeit ein, um ein bereits laufendes Fasten fortzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza cuando quieras, o registra tu última comida para retomar un ayuno ya en curso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez quand vous êtes prêt, ou enregistrez votre dernier repas pour reprendre un jeûne déjà en cours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "準備ができたら始めましょう。または最後の食事を記録して、すでに進行中の断食を引き継げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비되면 시작하세요. 또는 마지막 식사를 기록해 이미 진행 중인 단식을 이어갈 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij, kiedy chcesz, albo zapisz ostatni posiłek, aby kontynuować już trwający post."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почніть, коли будете готові, або вкажіть останній прийом їжі, щоб продовжити вже розпочатий піст."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "准备好就开始，或记录上一餐以继续已经进行中的断食。"
          }
        }
      }
    },
