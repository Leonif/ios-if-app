    "Still digesting. Insulin is up and your body is storing the energy from your last meal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال الهضم جاريًا. مستوى الإنسولين مرتفع وجسمك يخزّن طاقة وجبتك الأخيرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
