    "Restore first - if Pro is on this Apple Account it comes straight back.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بالاستعادة؛ إن كان IF24 Pro على حساب Apple هذا فسيعود فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell zuerst deine Käufe wieder her - wenn Pro auf diesem Apple Account liegt, ist es sofort zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura tus compras primero: si Pro está en esta cuenta de Apple, vuelve enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez d’abord vos achats : si Pro est sur ce compte Apple, il revient aussitôt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず購入を復元してください。このApple Accountで購入済みなら、すぐに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 복원해 보세요. 이 Apple 계정에 IF24 Pro가 있으면 바로 돌아와요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw przywróć zakupy - jeśli Pro jest na tym koncie Apple, wróci od razu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу відновіть покупки - якщо Pro є на цьому обліковому записі Apple, він одразу повернеться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先恢复购买，如果 Pro 在这个 Apple 账户上，它会马上回来。"
          }
        }
      }
    },
    "Restore purchases": {
      "localizations": {
        "uk": {
