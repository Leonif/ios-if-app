      "localizations" : {
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Сигналізація FGF21, індукована голодуванням, активує гепатичну аутофагію та деградацію ліпідів через JMJD3 гістонову деметилазу" }
        }
      }
    },
