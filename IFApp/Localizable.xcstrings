    "Still digesting. Insulin is up and your body is storing the energy from your last meal.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال الهضم جاريًا. مستوى الإنسولين مرتفع وجسمك يخزّن طاقة وجبتك الأخيرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch in der Verdauung. Der Insulinspiegel ist hoch und dein Körper speichert die Energie deiner letzten Mahlzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún digiriendo. La insulina está alta y tu cuerpo almacena la energía de tu última comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Digestion en cours. L'insuline est élevée et votre corps stocke l'énergie de votre dernier repas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ消化中です。インスリン値が高く、体は最後の食事のエネルギーを蓄えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 소화 중입니다. 인슐린이 높아 몸이 마지막 식사의 에너지를 저장하고 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa trawienie. Poziom insuliny jest wysoki, a ciało magazynuje energię z ostatniego posiłku."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває травлення. Інсулін підвищений, тіло запасає енергію з останнього прийому їжі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在消化。胰岛素升高，身体正在储存上一餐的能量。"
          }
        }
      }
    },
