    "Effect of Alternate-Day Fasting on Weight Loss, Weight Maintenance, and Cardioprotection Among Metabolically Healthy Obese Adults: A Randomized Clinical Trial" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأثير الصيام بالتناوب اليومي على فقدان الوزن والحفاظ عليه وحماية القلب لدى البالغين المصابين بالسمنة الأصحاء أيضيًا: تجربة سريرية عشوائية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirkung des Fastens jeden zweiten Tag auf Gewichtsverlust, Gewichtserhaltung und Kardioprotektion bei metabolisch gesunden adipösen Erwachsenen: eine randomisierte klinische Studie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efecto del ayuno en días alternos sobre la pérdida de peso, el mantenimiento del peso y la cardioprotección en adultos obesos metabólicamente sanos: un ensayo clínico aleatorizado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effet du jeûne un jour sur deux sur la perte de poids, le maintien du poids et la cardioprotection chez des adultes obèses métaboliquement sains : un essai clinique randomisé"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隔日断食が代謝的に健康な肥満成人の減量・体重維持・心保護に及ぼす影響：ランダム化比較試験"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "격일 단식이 대사적으로 건강한 비만 성인의 체중 감소, 체중 유지 및 심장 보호에 미치는 영향: 무작위 대조 임상시험"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpływ postu co drugi dzień na utratę masy ciała, jej utrzymanie i kardioprotekcję u metabolicznie zdrowych otyłych dorosłych: randomizowane badanie kliniczne"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вплив чергування днів голодування на втрату ваги, підтримку ваги та кардіопротекцію серед метаболічно здорових дорослих з ожирінням: рандомізоване клінічне дослідження"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隔日断食对代谢健康的肥胖成年人减重、体重维持及心脏保护的影响：一项随机临床试验"
          }
        }
      }
    },
