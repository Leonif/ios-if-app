    "history.streak.firstFast" : {
      "comment" : "Note on the summary card over the first fasts, under the streak counter.\nReplaces the old promise that tomorrow starts the streak. States the rule:\nonly a day whose goal was reached counts. Neutral, no blame, no exclamation.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل أول صيام. تحسب السلسلة الأيام التي تبلغ فيها هدفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstes Fasten erfasst. Eine Serie zählt die Tage, an denen du dein Ziel erreichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First fast logged. A streak counts the days you reach your goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer ayuno registrado. Una racha cuenta los días en los que alcanzas tu objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier jeûne enregistré. Une série compte les jours où vous atteignez votre objectif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の断食を記録しました。連続記録に数えられるのは、目標を達成した日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 단식을 기록했어요. 연속 기록에는 목표를 달성한 날만 들어가요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierwszy post zapisany. Seria liczy dni, w których osiągasz cel."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перший піст записано. Серія рахує дні, коли ціль досягнута."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已记录首次断食。连续记录只计算达成目标的天数。"
          }
        }
      }
    },
    "history.streak.lastOverline" : {
      "comment" : "Overline over the big streak number on the history summary card, in the\nstate where the run has ended. Uppercased in the UI. Hard budget 146pt,\nkeep it to two short words.",
      "localizations" : {
