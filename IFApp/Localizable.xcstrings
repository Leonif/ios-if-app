    "Pick how long a fast runs. The window starts when you end it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد مدة الصيام. تبدأ نافذة الأكل فور إنهائه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg fest, wie lange ein Fasten läuft. Das Essensfenster beginnt, wenn du es beendest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto dura un ayuno. La ventana de comida empieza cuando lo terminas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la durée d’un jeûne. La fenêtre alimentaire commence quand vous le terminez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食の長さを選べます。食事の時間帯は、断食を終えると始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마나 단식할지 정하세요. 단식을 끝내면 식사 시간이 시작돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak długo trwa post. Okno żywieniowe zaczyna się, gdy go zakończysz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, скільки триває піст. Вікно харчування починається, коли ви його завершите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一次断食的时长。你结束断食时，进食窗口就开始。"
          }
        }
      }
    },
