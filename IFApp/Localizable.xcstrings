    "We’ll back-date your fast so the timer stays accurate.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سنحتسب صيامك من ذلك الوقت ليبقى المؤقّت دقيقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir datieren dein Fasten zurück, damit der Timer genau bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustaremos la fecha de tu ayuno hacia atrás para que el temporizador sea preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous antidaterons votre jeûne pour que le minuteur reste précis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーが正確になるよう、断食の開始時刻をさかのぼって設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "타이머가 정확하도록 단식 시작 시각을 지난 시각으로 맞춰요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofniemy datę twojego postu, aby licznik pozostał dokładny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ми почнемо піст із того часу, щоб таймер залишався точним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会把你的断食时间回溯，让计时保持准确。"
          }
        }
      }
    },
    "When did you last eat?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى أكلت آخر مرة؟"
