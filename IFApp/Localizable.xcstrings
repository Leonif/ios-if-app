    "Keep going" : {
      "comment" : "Dismiss button on the streak milestone card. Encouragement, not an action on a fast — nothing starts, stops or changes. NOT \"Keep this fast\" (Reset sheet) and NOT \"Continue fasting\" (window-closed screen).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مواصلة"
          }
        },
        "de" : {
