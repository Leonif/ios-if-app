{
  "sourceLanguage": "en",
  "strings": {
    "%@ begins in %@": {
      "comment": "Next phase chip, e.g. 'Autophagy begins in 2h 36m'",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ %1$@ خلال %2$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beginnt in %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ comienza en %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ commence dans %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@後に始まります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@까지 %2$@ 남음"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zaczyna się za %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ почнеться через %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@将在%2$@后开始"
          }
        }
      }
    },
