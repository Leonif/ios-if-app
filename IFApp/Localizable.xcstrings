      "localizations" : {
        "uk" : {
          "stringUnit" : { "state" : "translated", "value" : "Вплив чергування днів голодування на втрату ваги, підтримку ваги та кардіопротекцію серед метаболічно здорових дорослих з ожирінням: рандомізоване клінічне дослідження" }
        }
      }
    },
